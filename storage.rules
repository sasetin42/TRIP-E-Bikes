rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isValidDocument() {
      return (request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('image/.*'))
        && request.resource.size < 25 * 1024 * 1024;
    }

    function isValidMedia() {
      return (request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*'))
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Global read access for all assets
    match /{allPaths=**} {
      allow read: if true;
    }

    // 1. Branding assets (Logos, favicons, brand identity)
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidImage();
    }

    // 2. SEO assets (OpenGraph images, meta banners)
    match /seo/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidImage();
    }

    // 3. Brand Assets (Legacy / alternative brand directory)
    match /brand-assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidImage();
    }

    // 4. Products (Product images, gallery, thumbnails)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidImage();
    }

    // 5. Media Library (General uploads, photos, videos)
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidMedia();
    }

    // 6. Videos (Product showcase, hero clips)
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidMedia();
    }

    // 7. Brochures & Specification Sheets (PDFs, docs)
    match /brochures/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isValidDocument();
    }

    // 8. User Avatars (Registration and profile photos)
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*'));
    }
  }
}
